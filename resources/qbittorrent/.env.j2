# host user/group that should own created files inside the container
# should be qbit's uid and gid
QBIT_UID={{ uid_dict['qbittorrent'] }}
QBIT_GID={{ gid_dict['qbittorrent'] }}

MUSICMEDIA_GID={{ gid_dict['musicmedia'] }}
VIDMEDIA_GID={{ gid_dict['vidmedia'] }}
OTHERMEDIA_GID={{ gid_dict['othermedia'] }}

# timezone
TZ={{ timezone }}

WEBUI_PORT={{ qbittorrent_webui_port }}
TORRENT_PORT={{ qbittorrent_torrent_port }}

# WireGuard private key from NordVPN (see gluetun wiki for how to obtain)
WIREGUARD_PRIVATE_KEY={{ wireguard_private_key }}

# Where qBittorrent stores its config on the host
QBITTORRENT_CONFIG_DIR={{ qbittorrent_config_dir }}

HOST_TEMP_DIR={{ external_dirs['qtmp']['path'] }}
HOST_MUSIC_DIR={{ external_dirs['music_untagged']['path'] }}
HOST_VID_DIR={{ external_dirs['vid']['path'] }}
HOST_OTHER_DIR={{ external_dirs['other']['path'] }}

# Your LAN subnet so gluetun can allow local traffic (adjust to your network)
LAN_NETWORK={{ subnet }}
