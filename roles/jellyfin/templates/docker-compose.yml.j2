---
services:
  shoko_server:
    shm_size: 256m
    container_name: shoko_server
    image: ghcr.io/shokoanime/server:latest
    restart: always
    group_add:
      - "${VIDMEDIA_GID}"
    environment:
      - "PUID={{ jellyfin_shoko_uid }}"
      - "PGID={{ jellyfin_shoko_gid }}"
      - "TZ=Etc/UTC"
    ports:
      - "{{ shoko_port }}:{{ shoko_port }}"
    volumes:
      - "{{ jellyfin_shoko_srv_dir }}:/home/shoko/.shoko"
      - "{{ vid_path }}/key_anime:/mnt/anime/key:ro"
      - "{{ vid_path }}/anime_show:/mnt/anime/show:ro"
      - "{{ vid_path }}/anime_movie:/mnt/anime/movie:ro"
  jellyfin:
    image: ghcr.io/jellyfin/jellyfin:latest
    user: "${JELLYFIN_UID}:${JELLYFIN_GID}"
    group_add:
      - "${VIDMEDIA_GID}"
    ports:
      - "${JELLYFIN_PORT}:${JELLYFIN_PORT}"
    restart: unless-stopped
    volumes:
      - "{{ jellyfin_srv_config_path }}:/config"
      - "{{ jellyfin_srv_cache_path }}:/cache"
      - "{{ vid_path }}:/vid:ro"